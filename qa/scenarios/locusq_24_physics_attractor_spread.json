{
  "scenario_version": "1.0",
  "id": "locusq_24_physics_attractor_spread",
  "name": "LocusQ 2.4 Physics Attractor Spread",
  "category": "spatial",
  "description": "Phase 2.4 acceptance proxy: attractor proximity must produce measurable spread DSP modulation. emit_spread base is 0 so all spread change is physics-driven. Verifies the attractor proximity -> spread additive offset hook defined in the DSP Mapping Contract.",

  "capability_requirements": {
    "required_effect_types": ["SPATIAL"],
    "required_behaviors": ["STATEFUL"],
    "excluded_behaviors": []
  },

  "stimulus": {
    "stimulus_id": "sweep",
    "stimulus_variant": "linear_sine",
    "parameters": {
      "start_hz": 440.0,
      "end_hz": 440.0,
      "amplitude": 0.35,
      "duration_seconds": 4.0
    }
  },

  "parameter_variations": {
    "pos_azimuth": 0.50,
    "pos_elevation": 0.50,
    "pos_distance": 0.20,
    "emit_gain": 0.5,
    "emit_spread": 0.0,
    "emit_directivity": 0.0,
    "phys_enable": 1.0,
    "phys_drag": 0.30,
    "phys_gravity": 0.0,
    "phys_throw": 0.0,
    "attractor_0_active": 1.0,
    "attractor_0_pos_x": 0.0,
    "attractor_0_pos_y": 1.2,
    "attractor_0_pos_z": 0.0,
    "attractor_0_strength": 80.0,
    "attractor_0_radius": 10.0,
    "rend_phys_rate": 1,
    "rend_master_gain": 0.5,
    "rend_room_enable": 0.0,
    "rend_doppler": 0.0,
    "rend_air_absorb": 0.0
  },

  "analysis_windows": {
    "proximity_window": {
      "type": "time_range",
      "start_seconds": 0.25,
      "end_seconds": 4.0,
      "description": "Attractor proximity modulation window — emitter is held near attractor origin, spread modulation should be active throughout"
    }
  },

  "expected_invariants": {
    "signal_present": {
      "metric": "rms_energy",
      "window": "proximity_window",
      "threshold": {
        "min": -85.0
      },
      "severity": "hard_fail"
    },
    "no_nan_inf": {
      "metric": "non_finite",
      "window": "proximity_window",
      "threshold": {
        "max_count": 0
      },
      "severity": "hard_fail"
    },
    "spatial_modulation_active": {
      "metric": "flux_rate",
      "window": "proximity_window",
      "threshold": {
        "min": 0.00001,
        "max": 10.0
      },
      "severity": "hard_fail"
    }
  },

  "pass_criteria": "All hard_fail invariants must pass."
}
