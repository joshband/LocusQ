{
  "scenario_version": "1.0",
  "id": "locusq_24_physics_collision_gain",
  "name": "LocusQ 2.4 Physics Collision Gain",
  "category": "spatial",
  "description": "Phase 2.4 acceptance proxy: inter-emitter collision energy must produce a gain transient envelope written to EmitterSlot.gain by PhysicsWorker. Two emitters with overlapping collision radii and opposing initial velocities are guaranteed to collide within the 2-second window. phys_collision_gain_scale=1.0 maximizes the transient amplitude. Transient burst detection is warn-only because exact timing depends on the simulation tick.",

  "capability_requirements": {
    "required_effect_types": ["SPATIAL"],
    "required_behaviors": ["STATEFUL"],
    "excluded_behaviors": []
  },

  "stimulus": {
    "stimulus_id": "sweep",
    "stimulus_variant": "linear_sine",
    "parameters": {
      "start_hz": 523.25,
      "end_hz": 523.25,
      "amplitude": 0.35,
      "duration_seconds": 2.0
    }
  },

  "parameter_variations": {
    "pos_azimuth": 0.50,
    "pos_elevation": 0.50,
    "pos_distance": 0.25,
    "emit_gain": 0.5,
    "emit_spread": 0.5,
    "emit_directivity": 0.0,
    "phys_enable": 1.0,
    "phys_drag": 0.0,
    "phys_gravity": 0.0,
    "phys_elasticity": 0.8,
    "phys_throw": 0.0,
    "phys_collision_radius": 0.8,
    "phys_collide_emitters": 1.0,
    "phys_collision_gain_scale": 1.0,
    "phys_collision_decay_ms": 50.0,
    "rend_phys_rate": 1,
    "rend_master_gain": 0.5,
    "rend_room_enable": 0.0,
    "rend_doppler": 0.0,
    "rend_air_absorb": 0.0
  },

  "scene_setup": {
    "description": "Two physics-enabled emitters with large collision radii (0.8m) fired toward each other with opposing velocities. Starting separation of ~2m guarantees overlap within the first simulation ticks.",
    "emitter_count": 2,
    "emitter_overrides": [
      { "index": 0, "pos_x": -1.0, "pos_y": 1.2, "pos_z": 0.0, "phys_enable": 1.0, "phys_vel_x": 8.0, "phys_collision_radius": 0.8 },
      { "index": 1, "pos_x":  1.0, "pos_y": 1.2, "pos_z": 0.0, "phys_enable": 1.0, "phys_vel_x": -8.0, "phys_collision_radius": 0.8 }
    ]
  },

  "analysis_windows": {
    "collision_window": {
      "type": "time_range",
      "start_seconds": 0.0,
      "end_seconds": 2.0,
      "description": "Full duration — collision expected to occur in the first ~0.1s given starting positions and velocities"
    }
  },

  "expected_invariants": {
    "signal_present": {
      "metric": "rms_energy",
      "window": "collision_window",
      "threshold": {
        "min": -85.0
      },
      "severity": "hard_fail"
    },
    "no_nan_inf": {
      "metric": "non_finite",
      "window": "collision_window",
      "threshold": {
        "max_count": 0
      },
      "severity": "hard_fail"
    },
    "transient_burst_detected": {
      "metric": "discontinuity_count",
      "window": "collision_window",
      "threshold": {
        "min_count": 1,
        "detection_threshold_db": 3.0
      },
      "severity": "warn"
    }
  },

  "pass_criteria": "All hard_fail invariants must pass."
}
