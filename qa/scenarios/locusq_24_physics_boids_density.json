{
  "scenario_version": "1.0",
  "id": "locusq_24_physics_boids_density",
  "name": "LocusQ 2.4 Physics Boids Density",
  "category": "spatial",
  "description": "Phase 2.4 acceptance proxy: Boids flock density must produce measurable spread DSP modulation when emitters form a cohesive group. emit_spread base is 0 so all spread change is physics-driven. Verifies the Boids density -> spread additive offset hook defined in the DSP Mapping Contract. Requires a multi-emitter scene; four emitters are assigned to flock group 1 with high cohesion weight.",

  "capability_requirements": {
    "required_effect_types": ["SPATIAL"],
    "required_behaviors": ["STATEFUL"],
